# OpenAI / LM Studio settings
OPENAI_BASE_URL="http://<YOUR_HOST_IP>:<PORT>/v1"
OPENAI_API_KEY="<YOUR_API_KEY>"
CHANAKYA_DEBUG=true
DATABASE_URL="sqlite:////path/to/Chanakya/chanakya_data/chanakya.db"

# Model selection is now managed through the Chanakya UI and persisted in the
# database. You do NOT need to set OPENAI_CHAT_MODEL_ID or similar env vars
# here. The UI dropdown lets you pick any model available on your AIR server,
# and your selection survives restarts automatically. If no model has been
# selected in the UI, the first available LLM from the AIR models list is used.
